# ---------------------------------------------------------------------------
# Одноразове налаштування: довіра між HCP Terraform і вашим акаунтом AWS.
#
# Ця конфігурація застосовується ЛОКАЛЬНО і лише один раз. Стан лишається
# у файлі поруч — це той рідкісний випадок, коли так робити нормально:
# конфігурація створює саме ту роль, без якої віддалені запуски неможливі.
#
# Якщо ви вже налаштували федерацію на попередніх заняттях — цю теку
# можна пропустити, лише додайте до наявної ролі воркспейси з префіксом
# hillel-eks у шаблон claim sub.
# ---------------------------------------------------------------------------

terraform {
  required_version = ">= 1.9"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = var.region
}
