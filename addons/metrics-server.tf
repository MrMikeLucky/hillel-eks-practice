# ---------------------------------------------------------------------------
# metrics-server — приклад встановлення зовнішнього компонента чартом Helm.
#
# Обраний навмисно: у нього немає жодних залежностей від AWS, тому він
# показує сам механізм у чистому вигляді. Без нього не працює ані
# kubectl top, ані горизонтальне автомасштабування подів.
#
# Решта компонентів із четвертого розділу заняття ставляться так само,
# але більшості з них потрібна ще й роль IAM, прив'язана до службового
# акаунта. Приклад такої прив'язки є у cluster/eks.tf для драйвера дисків.
# ---------------------------------------------------------------------------

resource "helm_release" "metrics_server" {
  count = var.enable_metrics_server ? 1 : 0

  name       = "metrics-server"
  repository = "https://kubernetes-sigs.github.io/metrics-server/"
  chart      = "metrics-server"
  version    = "3.12.2"
  namespace  = "kube-system"

  # Версія чарта закріплена навмисно: без цього оновлення чужого коду
  # прилетить між вашим планом і застосуванням.

  values = [yamlencode({
    resources = {
      requests = {
        cpu    = "50m"
        memory = "64Mi"
      }
    }
  })]
}
